# Copy this file to .env and fill in your values
# docker-compose reads .env automatically

# Slack webhook for Grafana alerts (required for alerting to work)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PostgreSQL credentials (optional — defaults to postgres/postgres/predictions)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=predictions

# Grafana admin password (optional — defaults to admin)
GF_SECURITY_ADMIN_PASSWORD=admin
